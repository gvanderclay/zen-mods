{
  "config": {
    // Prose is hard-wrapped by hand; line length is not worth a lint failure.
    "MD013": false,
    // Tables use the compact `|---|---|` separator throughout.
    "MD060": false
  },
  // .pi/ holds agent configuration and gitignored agent notes; .scratch/ holds throwaway
  // output. Neither contains published Markdown.
  "ignores": ["node_modules/**", "notes/**", ".pi/**", ".scratch/**"]
}
