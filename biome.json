{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 90
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "arrowParentheses": "asNeeded"
    },
    "globals": ["ChromeUtils", "IOUtils", "Services", "gBrowser", "gZenWorkspaces"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "mods/*/src/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        "packages/*/src/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*.bench.*",
        "!**/__tests__/**",
        "!**/benchmarks/**",
        "!**/fixtures/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 300,
                "skipBlankLines": false
              }
            }
          }
        }
      }
    },
    {
      "includes": ["mods/keep-loaded/src/application-coordinator.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": { "maxLines": 320, "skipBlankLines": false }
            }
          }
        }
      }
    },
    {
      "includes": ["mods/keep-loaded/src/application-queue.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": { "maxLines": 516, "skipBlankLines": false }
            }
          }
        }
      }
    },
    {
      "includes": ["mods/keep-loaded/src/application-wake.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": { "maxLines": 578, "skipBlankLines": false }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
