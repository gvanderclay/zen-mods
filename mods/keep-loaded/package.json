{
  "name": "@zen-mods/keep-loaded",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keeps an allowlist of pinned Zen tabs awake while the rest restore lazily.",
  "scripts": {
    "build": "node ../../scripts/build-mod.mjs",
    "install:local": "node ../../scripts/install-local.mjs keep-loaded",
    "dev": "node ../../scripts/build-mod.mjs --watch",
    "verify:dist": "node ../../scripts/build-mod.mjs && node ../../scripts/verify-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "test:watch": "vitest --config ../../vitest.config.ts --root .",
    "test:live-multi-window": "node tools/harness/probe-lifecycle.mjs",
    "test:live-production-window-close": "pnpm run build && node tools/harness/probe-production-window-close.mjs",
    "test:live-production-widget-ownership": "pnpm run build && node tools/harness/probe-production-widget-ownership.mjs",
    "test:live-production-widget-creator-close": "pnpm run build && node tools/harness/probe-production-widget-creator-close.mjs",
    "test:live-production-wake-transaction": "pnpm run build && node tools/harness/probe-production-wake-transaction.mjs",
    "test:live-production-crash-reload": "pnpm run build && node tools/harness/probe-production-crash-reload.mjs",
    "bench": "vitest bench --config ../../vitest.config.ts --root . --maxWorkers=1 --no-file-parallelism",
    "bench:record": "vitest bench --config ../../vitest.config.ts --root . --maxWorkers=1 --no-file-parallelism --outputJson ../../.benchmarks/keep-loaded.json",
    "bench:compare": "node ../../scripts/benchmark-environment.mjs --validate && vitest bench --config ../../vitest.config.ts --root . --maxWorkers=1 --no-file-parallelism --compare ../../.benchmarks/keep-loaded.json",
    "probe:sockets": "node tools/harness/probe-sockets.mjs",
    "probe:overhead": "node tools/harness/probe-overhead.mjs",
    "probe:panel": "node tools/harness/probe-panel.mjs",
    "probe:mail": "node tools/harness/probe-mail.mjs",
    "probe:title": "node tools/harness/probe-title.mjs",
    "probe:freshness": "node tools/harness/probe-freshness.mjs",
    "probe:pulse": "node tools/harness/probe-pulse.mjs",
    "probe:label": "node tools/harness/probe-label.mjs",
    "probe:relabel": "node tools/harness/probe-relabel.mjs",
    "probe:wiring": "node tools/harness/probe-wiring.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run verify:dist"
  }
}
