[
  {
    "type": "string",
    "property": "zen.keep-loaded.match",
    "label": "Keep pinned tabs matching (comma separated)",
    "placeholder": "mail.google.com,slack.com",
    "defaultValue": "mail.google.com,calendar.google.com,slack.com"
  },
  {
    "type": "checkbox",
    "property": "zen.keep-loaded.lazy-pinned",
    "label": "Load pinned tabs lazily (applies from the next start)",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "property": "zen.keep-loaded.debug",
    "label": "Log what was kept to the Browser Console",
    "defaultValue": true
  },
  {
    "type": "string",
    "property": "zen.keep-loaded.crash-attempts",
    "label": "Recover the same crashed tab at most this many times (0 to never recover)",
    "placeholder": "3",
    "defaultValue": "3"
  },
  {
    "type": "string",
    "property": "zen.keep-loaded.crash-window-minutes",
    "label": "Forget a recovery attempt after this many minutes",
    "placeholder": "60",
    "defaultValue": "60"
  },
  {
    "type": "string",
    "property": "zen.keep-loaded.freshen-seconds",
    "label": "Run a kept tab's page every this many seconds, so its title keeps up (0 to never)",
    "placeholder": "120",
    "defaultValue": "0"
  },
  {
    "type": "string",
    "property": "zen.keep-loaded.freshen-hold-seconds",
    "label": "Let each of those runs last this many seconds",
    "placeholder": "5",
    "defaultValue": "5"
  }
]
