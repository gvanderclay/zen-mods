{
  "name": "@zen-mods/load-bar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shows a delayed activity line for visible Zen browser panes.",
  "dependencies": {
    "@zen-mods/sine-lifecycle": "workspace:*"
  },
  "devDependencies": {
    "@zen-mods/live-harness": "workspace:*"
  },
  "scripts": {
    "build": "node ../../scripts/build-mod.mjs",
    "install:local": "node ../../scripts/install-local.mjs load-bar",
    "dev": "node ../../scripts/build-mod.mjs --watch",
    "verify:dist": "node ../../scripts/build-mod.mjs && node ../../scripts/verify-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "test:watch": "vitest --config ../../vitest.config.ts --root .",
    "test:live-default-pane": "pnpm run build && node tools/harness/probe-default-pane.mjs",
    "test:live-pane-seam": "pnpm run build && node tools/harness/probe-pane-seam.mjs",
    "test:live-settings": "pnpm run build && node tools/harness/probe-settings.mjs",
    "test:live-visible-panes": "pnpm run build && node tools/harness/probe-visible-panes.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run verify:dist"
  }
}
