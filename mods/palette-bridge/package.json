{
  "name": "@zen-mods/palette-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Applies an external semantic palette to Zen browser chrome.",
  "dependencies": {
    "@zen-mods/sine-lifecycle": "workspace:*"
  },
  "devDependencies": {
    "@zen-mods/live-harness": "workspace:*"
  },
  "scripts": {
    "build": "node ../../scripts/build-mod.mjs",
    "install:local": "node ../../scripts/install-local.mjs palette-bridge",
    "dev": "node ../../scripts/build-mod.mjs --watch",
    "verify:dist": "node ../../scripts/build-mod.mjs && node ../../scripts/verify-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "test:live-xul": "node tools/harness/probe-hot-reload.mjs",
    "test:watch": "vitest --config ../../vitest.config.ts --root .",
    "preview:live-xul": "node tools/harness/preview-palettes.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run verify:dist"
  }
}
