{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Palette Bridge palette",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "accent",
    "mainBackground",
    "secondarySurface",
    "selectionSurface",
    "border",
    "normalForeground",
    "mutedForeground",
    "strongForeground"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "displayName": { "type": "string" },
    "mode": { "enum": ["dark", "light"] },
    "accent": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
    "mainBackground": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
    "secondarySurface": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "selectionSurface": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "border": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
    "normalForeground": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "mutedForeground": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "strongForeground": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    }
  }
}
