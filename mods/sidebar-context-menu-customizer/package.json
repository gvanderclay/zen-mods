{
  "name": "@zen-mods/sidebar-context-menu-customizer",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Customizes the context menus in Zen's sidebar.",
  "scripts": {
    "build": "node ../../scripts/build-mod.mjs",
    "install:local": "node ../../scripts/install-local.mjs sidebar-context-menu-customizer",
    "dev": "node ../../scripts/build-mod.mjs --watch",
    "verify:dist": "node ../../scripts/build-mod.mjs && node ../../scripts/verify-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "test:watch": "vitest --config ../../vitest.config.ts --root .",
    "test:live-xul": "pnpm run build && node tools/harness/probe-lifecycle.mjs",
    "test:live-xul:headed": "pnpm run build && node tools/harness/probe-lifecycle.mjs --headed --samples 1",
    "test:live-xul:record": "pnpm run build && node tools/harness/probe-lifecycle.mjs --record",
    "bench": "vitest bench --config ../../vitest.config.ts --root . --maxWorkers=1 --no-file-parallelism",
    "bench:record": "vitest bench --config ../../vitest.config.ts --root . --maxWorkers=1 --no-file-parallelism --outputJson ../../.benchmarks/sidebar-context-menu-customizer.json",
    "bench:compare": "node ../../scripts/benchmark-environment.mjs --validate && vitest bench --config ../../vitest.config.ts --root . --maxWorkers=1 --no-file-parallelism --compare ../../.benchmarks/sidebar-context-menu-customizer.json",
    "check": "pnpm run typecheck && pnpm run test && pnpm run verify:dist"
  },
  "dependencies": {
    "@zen-mods/browser-chrome-ui": "workspace:*",
    "@zen-mods/sine-lifecycle": "workspace:*"
  }
}
