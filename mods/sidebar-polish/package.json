{
  "name": "@zen-mods/sidebar-polish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Integrates Firefox's Bookmarks and History sidebars with Zen's visual language.",
  "dependencies": {
    "@zen-mods/sine-lifecycle": "workspace:*"
  },
  "scripts": {
    "build": "node ../../scripts/build-mod.mjs",
    "install:local": "node ../../scripts/install-local.mjs sidebar-polish",
    "verify:dist": "node ../../scripts/build-mod.mjs && node ../../scripts/verify-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "check": "pnpm run typecheck && pnpm run test && pnpm run verify:dist"
  }
}
