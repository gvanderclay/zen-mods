{
  "name": "zen-mods",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal Sine mods for Zen Browser.",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "install:local": "node scripts/install-local.mjs",
    "verify:dist": "pnpm -r --if-present run verify:dist",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "pnpm -r --if-present run test",
    "test:root": "vitest run --config vitest.config.ts --root . scripts/install-local.test.mjs",
    "docs": "markdownlint-cli2 \"**/*.md\"",
    "check": "pnpm run test:root && pnpm -r --if-present run check && pnpm run lint && pnpm run docs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "esbuild": "0.28.1",
    "lefthook": "2.1.10",
    "markdownlint-cli2": "0.23.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
