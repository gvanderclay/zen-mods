{
  "name": "zen-mods",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal Sine mods for Zen Browser.",
  "workspaces": [
    "mods/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "verify:dist": "npm run verify:dist --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "npm run test --workspaces --if-present",
    "docs": "markdownlint-cli2 \"**/*.md\"",
    "check": "npm run check --workspaces --if-present && npm run lint && npm run docs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "esbuild": "0.28.1",
    "lefthook": "2.1.10",
    "markdownlint-cli2": "0.23.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
